DISCORD_TOKEN=
GROQ_API_KEY=
# Opcional: respaldo gratuito, habilitado al completar ambos valores.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Metadatos operacionales del mismo servidor; nunca contenido ni DMs.
LOG_CHANNEL_ID=
# Opcional: mapa JSON de servidor a canal de logs, e.g. {"guild_id":"channel_id"}.
TARS_LOG_CHANNELS=
# Opcional: IDs de roles autorizados, separados por coma; reemplaza config/moderation-roles.json.
TARS_MODERATOR_ROLE_IDS=
# Retención de contadores diarios/horarios, entre 1 y 3650 días. Eventos: 45 días.
TARS_ACTIVITY_RETENTION_DAYS=365
# Opcional: canal privado para persistir los mutes; por defecto usa LOG_CHANNEL_ID.
TARS_STATE_CHANNEL_ID=
# Solo sin canal de estado/logs: carpeta en disco persistente (por defecto data/).
TARS_DATA_DIR=
# El alojamiento suele asignarlo automáticamente.
PORT=3000
# Límite interno de respuestas de IA por minuto.
TARS_LLM_REQUESTS_PER_MINUTE=6

# Opcional: token del bot RADAR para su presencia conectada junto a TARS.
RADAR_DISCORD_TOKEN=
